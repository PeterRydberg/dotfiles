#!/bin/sh
set -eu

{{ if eq .chezmoi.os "linux" }}

# --- GUI detection helpers -----------------------------------

has_display_env() {
  [ -n "${DISPLAY:-}" ] || [ -n "${WAYLAND_DISPLAY:-}" ]
}

has_x11_or_wayland_binaries() {
  command -v Xorg >/dev/null 2>&1 ||
  command -v wayland-server >/dev/null 2>&1
}

is_graphical_target() {
  command -v systemctl >/dev/null 2>&1 &&
  systemctl get-default 2>/dev/null | grep -q graphical.target
}

is_wsl() {
  case "$(uname -r)" in
    *Microsoft*|*microsoft*) return 0 ;;
    *) return 1 ;;
  esac
}

# --- Decision logic ------------------------------------------

if is_wsl; then
  echo "WSL detected. Skipping Firefox installation."
  exit 0
fi

if ! has_display_env && ! (has_x11_or_wayland_binaries && is_graphical_target); then
  echo "No usable desktop environment detected. Skipping Firefox installation."
  exit 0
fi

echo "Desktop-capable system detected."

# --- Installation --------------------------------------------

if command -v firefox >/dev/null 2>&1; then
  echo "Firefox already installed."
  exit 0
fi

echo "Installing Firefox..."

if command -v apt >/dev/null 2>&1; then
  sudo apt update
  sudo apt install -y firefox

elif command -v dnf >/dev/null 2>&1; then
  sudo dnf install -y firefox

elif command -v pacman >/dev/null 2>&1; then
  sudo pacman -Sy --noconfirm firefox

elif command -v apk >/dev/null 2>&1; then
  sudo apk add firefox

else
  echo "No supported package manager found."
  exit 1
fi

echo "Firefox installation complete."

{{ else }}

echo "Skipping Firefox installation (non-Linux host)."
exit 0

{{ end }}

