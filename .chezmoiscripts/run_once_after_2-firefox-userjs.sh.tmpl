#!/bin/sh
set -eu

{{ if eq .chezmoi.os "linux" }}

# --- GUI detection helpers -----------------------------------

has_display_env() {
  [ -n "${DISPLAY:-}" ] || [ -n "${WAYLAND_DISPLAY:-}" ]
}

has_x11_or_wayland_binaries() {
  command -v Xorg >/dev/null 2>&1 ||
  command -v wayland-server >/dev/null 2>&1
}

is_graphical_target() {
  command -v systemctl >/dev/null 2>&1 &&
  systemctl get-default 2>/dev/null | grep -q graphical.target
}

is_wsl() {
  case "$(uname -r)" in
    *Microsoft*|*microsoft*) return 0 ;;
    *) return 1 ;;
  esac
}

# --- Decision logic ------------------------------------------

if is_wsl; then
  echo "WSL detected. Skipping Firefox user.js setup."
  exit 0
fi

if ! has_display_env && ! (has_x11_or_wayland_binaries && is_graphical_target); then
  echo "No usable desktop environment detected. Skipping Firefox user.js setup."
  exit 0
fi

echo "Desktop-capable system detected. Configuring Firefox user.js..."

# --- Firefox checks ------------------------------------------

if ! command -v firefox >/dev/null 2>&1; then
  echo "Firefox is not installed. Skipping user.js setup."
  exit 0
fi

FIREFOX_DIR="$HOME/.mozilla/firefox"
USERJS_SOURCE="$FIREFOX_DIR/user.js"

mkdir -p "$FIREFOX_DIR"

# Ensure at least one profile exists
if ! find "$FIREFOX_DIR" -maxdepth 1 -type d -name "*.default*" -print -quit | grep -q .; then
  echo "No Firefox profile found. Creating default profile..."
  firefox -headless -CreateProfile default >/dev/null 2>&1 || true
fi

if [ ! -f "$USERJS_SOURCE" ]; then
  echo "No $USERJS_SOURCE found. Skipping user.js linking."
  exit 0
fi

# --- Link user.js into all default profiles ------------------

for PROFILE_DIR in "$FIREFOX_DIR"/*.default* "$FIREFOX_DIR"/*.Default*; do
  if [ -d "$PROFILE_DIR" ]; then
    ln -sf "$USERJS_SOURCE" "$PROFILE_DIR/user.js"
    echo "Linked user.js into: $PROFILE_DIR"
  fi
done

echo "Firefox user.js configuration complete."

{{ else }}

echo "Skipping Firefox user.js setup (non-Linux host)."
exit 0

{{ end }}

