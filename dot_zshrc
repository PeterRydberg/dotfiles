SSH_AGENT_SOCK="$HOME/.ssh/agent.sock"
export SSH_AUTH_SOCK="$SSH_AGENT_SOCK"


# SSH
if ! ssh-add -l >/dev/null 2>&1; then
  # Agent is dead or unreachable
  rm -f "$SSH_AGENT_SOCK"
  eval "$(ssh-agent -a "$SSH_AGENT_SOCK" -s)" >/dev/null
  ssh-add ~/.ssh/id_ed25519 2>/dev/null
fi


# Random
eval "$(starship init zsh)"
fpath=(~/.zsh/completions $fpath)

autoload -Uz compinit
compinit

# Don’t expand/normalize input, just complete literally
zstyle ':completion:*' completer _complete _ignored
# Tell path completion it’s okay to continue after "." and ".."
zstyle ':completion:*' special-dirs true


# Paths
export PATH="$HOME/bin:$PATH"
export EDITOR=vim
export VISUAL="$EDITOR"


# Keybindings
bindkey -e

# Jump word
bindkey "\e[1;5D" backward-word   # Ctrl+Left
bindkey "\e[1;5C" forward-word    # Ctrl+Right

# Delete previous word
bindkey '^H' backward-kill-word

# Delete next word
bindkey "\e[3;5~" kill-word

# Delete next character
bindkey "\e[3~" delete-char

# Undo/redo
bindkey '^Z' undo
bindkey '^[[122;6u' redo


# Alias #
alias cz=chezmoi
alias k='kubectl'
alias pn=pnpm


# WSL #
if [[ -n "$WSL_INTEROP" || -n "$WSL_DISTRO_NAME" ]]; then
  keep_current_path() {
    printf "\e]9;9;%s\e\\" "$(wslpath -w "$PWD")"
  }
  precmd_functions+=(keep_current_path)
fi


export NVM_DIR="$HOME/.nvm"
[ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"  # This loads nvm
[ -s "$NVM_DIR/bash_completion" ] && \. "$NVM_DIR/bash_completion"  # This loads nvm bash_completion

[ -f ~/.fzf.zsh ] && source ~/.fzf.zsh


# PNPM
export PNPM_HOME="/home/hmpry/.local/share/pnpm"
case ":$PATH:" in
  *":$PNPM_HOME:"*) ;;
  *) export PATH="$PNPM_HOME:$PATH" ;;
esac


# History
# History file and size
HISTFILE=~/.zsh_history
HISTSIZE=50000
SAVEHIST=50000

# Key options
setopt APPEND_HISTORY        # Append rather than overwrite the history file
setopt INC_APPEND_HISTORY    # Write to history file immediately, not on shell exit
setopt SHARE_HISTORY         # Share history across all active sessions in real time
setopt HIST_IGNORE_DUPS      # Don't record duplicate consecutive commands
setopt HIST_IGNORE_ALL_DUPS  # Remove older duplicate entries from history
setopt HIST_IGNORE_SPACE     # Don't record commands prefixed with a space
setopt HIST_REDUCE_BLANKS    # Strip superfluous blanks
setopt HIST_VERIFY           # Show expanded history command before executing


# Source local overrides (not tracked by chezmoi)
[[ -f ~/.zshrc.local ]] && source ~/.zshrc.local
