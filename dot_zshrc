SSH_AGENT_SOCK="$HOME/.ssh/agent.sock"
export SSH_AUTH_SOCK="$SSH_AGENT_SOCK"

if ! ssh-add -l >/dev/null 2>&1; then
  # Agent is dead or unreachable
  rm -f "$SSH_AGENT_SOCK"
  eval "$(ssh-agent -a "$SSH_AGENT_SOCK" -s)" >/dev/null
  ssh-add ~/.ssh/id_ed25519 2>/dev/null
fi

eval "$(starship init zsh)"
fpath=(~/.zsh/completions $fpath)

autoload -Uz compinit
compinit

# Don’t expand/normalize input, just complete literally
zstyle ':completion:*' completer _complete _ignored
# Tell path completion it’s okay to continue after "." and ".."
zstyle ':completion:*' special-dirs true

export PATH="$HOME/bin:$PATH"

export EDITOR=vim
export VISUAL="$EDITOR"

# Jump word
bindkey "\e[1;5D" backward-word   # Ctrl+Left
bindkey "\e[1;5C" forward-word    # Ctrl+Right

# Delete previous word
bindkey '^H' backward-kill-word

# Delete next word
bindkey "\e[3;5~" kill-word

# Delete next character
bindkey "\e[3~" delete-char





# Alias #

alias cz=chezmoi



# WSL #
if [[ -n "$WSL_INTEROP" || -n "$WSL_DISTRO_NAME" ]]; then
  keep_current_path() {
    printf "\e]9;9;%s\e\\" "$(wslpath -w "$PWD")"
  }
  precmd_functions+=(keep_current_path)
fi


# Authorize external NPM repos #
export NPM_AUTH_TOKEN=$(gh auth token)
